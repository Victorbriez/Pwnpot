# Copy to .env.local and fill in. Never commit .env.local.

# Base Sepolia RPC used by the frontend. Leave empty to use the public RPC.
# Local dev: `pnpm chain:deploy` sets it to http://127.0.0.1:8545.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Deployed CTFPlatform address on Base Sepolia (set after deployment).
# Empty = demo mode (mock data). Local dev: written by `pnpm chain:deploy`.
NEXT_PUBLIC_CTF_PLATFORM_ADDRESS=

# Block of the CTFPlatform deployment: events are read from there.
# Local dev: written by `pnpm chain:deploy`.
NEXT_PUBLIC_CTF_PLATFORM_DEPLOY_BLOCK=

# Test factory (TestLevel, solved without exploit). Local dev only:
# written by `pnpm chain:deploy`, offered in the creation form.
NEXT_PUBLIC_TEST_FACTORY_ADDRESS=

# Public URL of the site, used for absolute links (share previews, sitemap).
# Optional on Vercel: the production URL is picked up automatically.
NEXT_PUBLIC_SITE_URL=
