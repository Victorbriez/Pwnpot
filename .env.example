# Copy to .env.local and fill in. Never commit .env.local.

# Base Sepolia RPC used by the frontend. Leave empty to use publicnode (it must
# accept eth_getLogs over 50 000 blocks: sepolia.base.org does not).
# Local dev: `pnpm chain:deploy` sets it to http://127.0.0.1:8545.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Deployed CTFPlatform address on Base Sepolia (`pnpm contracts:env` prints these values).
# Values below: the demo deployment used by the site (`pwnpot-disputes-demo`, 10 min
# contestation). The real one (48 h) is listed in README.md § Adresses déployées.
# Empty = demo mode (mock data). Local dev: written by `pnpm chain:deploy`.
NEXT_PUBLIC_CTF_PLATFORM_ADDRESS=0xb701e1c29F0cA0F237414a4F395Ed1f04e9fbf60

# Block of the CTFPlatform deployment: events are read from there.
# Local dev: written by `pnpm chain:deploy`.
NEXT_PUBLIC_CTF_PLATFORM_DEPLOY_BLOCK=63922316

# Shared factories of levels 2 (Impostor) and 3 (CodeSafe), deployed with the platform.
# Empty = level not offered in the creation form. Level 1 (Vault) has no address:
# each organizer deploys their own from the creation form.
# Local dev: written by `pnpm chain:deploy`.
NEXT_PUBLIC_IMPOSTOR_FACTORY_ADDRESS=0x75561314e7A13132C2181de3A9Af063e5a57440e
NEXT_PUBLIC_CODE_SAFE_FACTORY_ADDRESS=0x029824C81B59de62D874d89dfDBFD8517708c7f0

# Test factory (TestLevel, solved without exploit), offered in the creation form.
# Set on Vercel Preview only, never in Production. Local dev: written by `pnpm chain:deploy`.
NEXT_PUBLIC_TEST_FACTORY_ADDRESS=0x06fc0de322568B78650b40364Abb15936bBd1254

# Public URL of the site, used for absolute links (share previews, sitemap).
# Optional on Vercel: the production URL is picked up automatically.
NEXT_PUBLIC_SITE_URL=
