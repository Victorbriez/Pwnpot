# Copy to .env.local and fill in. Never commit .env.local.

# Base Sepolia RPC used by the frontend. Leave empty to use the public RPC.
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=

# Deployed CTFPlatform address on Base Sepolia (set after deployment).
NEXT_PUBLIC_CTF_PLATFORM_ADDRESS=

# Public URL of the site, used for absolute links (share previews, sitemap).
# Optional on Vercel: the production URL is picked up automatically.
NEXT_PUBLIC_SITE_URL=
