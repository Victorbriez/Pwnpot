{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "app/globals.css",
    "baseColor": "neutral",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "menuColor": "default",
  "menuAccent": "subtle",
  "registries": {
    "@onchain-ui": "https://onchain-ui.dev/r/{name}.json",
    "@trophy-ui": "https://ui.trophy.so/r/{name}.json",
    "@stepper": "https://francozeta-stepper.vercel.app/r/{name}.json",
    "@json-view-cn": "https://json-view-cn.vercel.app/r/{name}.json",
    "@basecn": "https://basecn.dev/r/{name}.json",
    "@coss": "https://coss.com/ui/r/{name}.json",
    "@afterglow": "https://afterglow.thebuilder.dk/r/{name}.json"
  }
}
